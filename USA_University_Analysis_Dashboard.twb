        </calculation>
      </column>
      <column caption='Percentage Rejected' datatype='real' name='[Calculation_0606151482363908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Status]=&quot;Reject&quot; THEN 1 ELSE 0 END)/COUNT([Status])' />
