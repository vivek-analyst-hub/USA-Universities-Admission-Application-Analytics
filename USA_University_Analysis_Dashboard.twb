      <column caption='IELTS Scroe' datatype='real' name='[Calculation_0412087330021376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Eng_test]=&quot;IELTS&quot; THEN [Test_score] END' />
      </column>
      <column caption='TOEFL Score' datatype='real' name='[Calculation_0412087330664449]' role='measure' type='quantitative'>
