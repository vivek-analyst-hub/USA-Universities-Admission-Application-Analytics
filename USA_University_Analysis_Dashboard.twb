      </column>
      <column caption='Select Metrics' datatype='real' name='[Calculation_0606151470944258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0606151469510657]&#13;&#10;WHEN &quot;GRE&quot; THEN AVG([GRE_SCORE])&#13;&#10;WHEN &quot;IELTS&quot; THEN AVG([Calculation_0412087330021376])&#13;&#10;WHEN &quot;TOEFL&quot; THEN AVG([Calculation_0412087330664449])&#13;&#10;END' />
      </column>
